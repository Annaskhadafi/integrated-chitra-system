# ==========================================
# DOKPLOY / DOCKER ENVIRONMENT CONFIGURATION
# ==========================================
# Database Connection Configuration for Integrated Chitra System (ICS)

# Host database (Di Dokploy: gunakan nama service database internal Dokploy, e.g. integrated-chitra-system-database-x77gvi atau IP/Host)
DB_HOST=integrated-chitra-system-database-x77gvi

# Port database (Default MySQL: 3306)
DB_PORT=3306

# Username database
DB_USER=root

# Password database
DB_PASS=your_database_password_here

# Database Names
DB_NAME=chitraparatama_ics
DB_NAME2=chitraparatama_fleetlist
DB_NAME3=chitraparatama_repair_job_card
DB_NAME5=chitraparatama_warranty
DB_NAME6=chitraparatama_vhs_stock
DB_NAME8=chitraparatama_competitor
